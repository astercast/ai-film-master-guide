{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build_site.py && python3 scripts/write_health.py",
  "cleanUrls": true,
  "functions": {
    "api/calc-cost.js": {
      "maxDuration": 10,
      "includeFiles": "data/v1/**"
    },
    "api/models-changes.js": {
      "maxDuration": 10,
      "includeFiles": "data/v1/**"
    },
    "api/models-pricing.js": {
      "maxDuration": 10,
      "includeFiles": "data/v1/**"
    },
    "api/models-status.js": {
      "maxDuration": 10,
      "includeFiles": "data/v1/**"
    }
  },
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ],
      "source": "/api/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=600, stale-while-revalidate=86400"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "source": "/data/v1/(.*)"
    },
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "source": "/(.*)"
    }
  ],
  "installCommand": "echo 'no dependencies'",
  "outputDirectory": "site",
  "trailingSlash": false
}
