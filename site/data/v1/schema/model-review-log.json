{"$id":"https://ai-film-master-guide.vercel.app/data/v1/schema/model-review-log.json","$schema":"http://json-schema.org/draft-07/schema#","description":"Watchtower review log: the adjudication record for checker flags and failed sources. Every review pass records what was re-fetched, the verdict per flag, and the basis — so a cleared queue is an audited queue, not a forgotten one. Hand-authored; preserved across API rebuilds.","properties":{"format":{"const":"model-review-log/1.0","type":"string"},"note":{"type":"string"},"reviews":{"items":{"properties":{"failed_source_reviews":{"items":{"properties":{"basis":{"type":"string"},"group":{"type":"string"},"models":{"items":{"type":"string"},"type":"array"},"verdict":{"type":"string"}},"required":["group","models","verdict","basis"],"type":"object"},"type":"array"},"flag_reviews":{"items":{"properties":{"basis":{"type":"string"},"detected_at":{"type":"string"},"model":{"type":"string"},"model_id":{"type":"string"},"sources_changed":{"items":{"type":"string"},"type":"array"},"verdict":{"enum":["dismissed-no-record-change","dismissed-source-excluded","promoted-record-updated"],"type":"string"}},"required":["model","model_id","detected_at","sources_changed","verdict","basis"],"type":"object"},"type":"array"},"id":{"type":"string"},"method":{"type":"string"},"outcome":{"type":"string"},"reviewed_at":{"format":"date","type":"string"},"reviewer":{"type":"string"},"scope":{"type":"string"}},"required":["id","reviewed_at","scope","method","outcome","flag_reviews","failed_source_reviews"],"type":"object"},"type":"array"}},"required":["format","note","reviews"],"title":"ModelReviewLog","type":"object"}
