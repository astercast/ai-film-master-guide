{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PromptTemplate",
  "type": "object",
  "required": [
    "id",
    "title",
    "track",
    "prompt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "track": {
      "type": "string",
      "enum": [
        "core",
        "animated",
        "photorealistic",
        "performance",
        "audio",
        "longform",
        "repair"
      ]
    },
    "prompt": {
      "type": "string"
    },
    "anatomy": {
      "type": [
        "string",
        "null"
      ]
    },
    "use": {
      "type": [
        "string",
        "null"
      ]
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
