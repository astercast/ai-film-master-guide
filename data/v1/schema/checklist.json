{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Checklists",
  "description": "Production checklists (pre-production, per-shot, continuity, audio, delivery) with item arrays.",
  "type": "object",
  "required": [
    "version",
    "observed",
    "checklists"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "observed": {
      "format": "date"
    },
    "checklists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
